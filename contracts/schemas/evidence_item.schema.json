{
  "$defs": {
    "Availability": {
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "UNKNOWN"
      ],
      "title": "Availability",
      "type": "string"
    },
    "FileLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Repo-relative POSIX path",
          "title": "Path",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileLocation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Pointers back to the raw observations behind a value.",
      "properties": {
        "commits": {
          "description": "Full commit SHAs",
          "items": {
            "type": "string"
          },
          "title": "Commits",
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileLocation"
          },
          "title": "Files",
          "type": "array"
        },
        "trace_ids": {
          "items": {
            "type": "string"
          },
          "title": "Trace Ids",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Source": {
      "enum": [
        "STATIC",
        "GIT",
        "CONFIG",
        "RUNTIME",
        "EXTERNAL"
      ],
      "title": "Source",
      "type": "string"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open interval [start, end) that a time-sensitive value covers.",
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "description": "Deterministic; filled in automatically when omitted",
      "title": "Evidence Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "repo_id": {
      "pattern": "^[\\w.-]+/[\\w.-]+$",
      "title": "Repo Id",
      "type": "string"
    },
    "snapshot": {
      "description": "Repository commit analyzed",
      "pattern": "^[0-9a-f]{40}$",
      "title": "Snapshot",
      "type": "string"
    },
    "component_id": {
      "pattern": "^[A-Za-z_$][\\w$]*(\\.[A-Za-z_$][\\w$]*)*$",
      "title": "Component Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "evidence_type": {
      "title": "Evidence Type",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "examples": [
        "commits",
        "days",
        "lines"
      ],
      "title": "Unit"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "as_of": {
      "description": "Only data strictly before this instant was used",
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extraction_method": {
      "examples": [
        "git_history@0.1.0"
      ],
      "title": "Extraction Method",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "repo_id",
    "snapshot",
    "component_id",
    "source",
    "evidence_type",
    "availability",
    "as_of",
    "extraction_method"
  ],
  "title": "EvidenceItem",
  "type": "object",
  "$id": "seir/evidence_item/1.2.0"
}
